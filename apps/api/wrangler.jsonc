{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "haas-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
}
